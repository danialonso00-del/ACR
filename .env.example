# --- Assistent IA (opcional) -------------------------------------------------
# Sense clau, l'assistent funciona en "Mode demostració sense model connectat"
# (consultes guiades deterministes). La clau només es llegeix al servidor.
ANTHROPIC_API_KEY=
# Model (per defecte claude-opus-5-5). Esforç: low | medium | high
ARC_AI_MODEL=claude-opus-5-5
ARC_AI_EFFORT=medium
# Pressupost per pregunta
ARC_AI_MAX_TOOL_ROUNDS=6
ARC_AI_MAX_OUTPUT_TOKENS=8000
ARC_AI_TOKEN_BUDGET=120000
ARC_AI_TIMEOUT_MS=90000
# Fallback automàtic de model en cas de rebuig per seguretat (default | off)
ARC_AI_FALLBACKS=default

# --- Connector SDR (lectura pública, backend) --------------------------------
# Lectura en viu de galeries/imatges del SDR des del backend (1 = sí, 0 = no)
SDR_LIVE=1
SDR_MIN_INTERVAL_MS=2000
# SDR_USER_AGENT="ARC-Intelligencia-Residus-Demo/0.1 (MTI technology demo; read-only; low rate)"
